{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "업무캘린더",
  "mainBinaryName": "work-calendar",
  "version": "1.1.0",
  "identifier": "io.github.jayfwng.workcalendar",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "업무 캘린더",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "visible": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "업무 일정, 체크리스트, 반복 업무 템플릿",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"]
      }
    }
  }
}
